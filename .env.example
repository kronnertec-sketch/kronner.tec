NEXT_PUBLIC_SUPABASE_URL=https://<projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave service_role do Supabase (somente servidor) para sincronizar assinaturas Stripe no Postgres
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
# Segredo do webhook Stripe (endpoint /api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=whsec_...
# Opcional: se vazio, o app busca os preços pelos lookup_keys kroner_base_monthly / kroner_chair_monthly
STRIPE_BASE_PRICE_ID=
STRIPE_CHAIR_PRICE_ID=
# Obrigatório em produção (URL https:// canônica da aplicação)
KRONER_PUBLIC_ORIGIN=https://kronner.vercel.app
